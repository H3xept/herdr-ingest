root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[{bin/herdr-ingest,lazy-brief,examples/summarise-git-blame}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
